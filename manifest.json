{
  "name": "Mein In-and-Out-Book",
  "short_name": "In-and-Out",
  "description": "Prüft auf deinem Gerät, was hereinkommt: Dateien, PDFs, Bilder und E-Mails auf versteckte Anweisungen an eine KI.",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "lang": "de",
  "background_color": "#f6f8f8",
  "theme_color": "#0f6e6e",
  "icons": [
    { "src": "icons/icon-192.png?v=3", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png?v=3", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png?v=3", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./teilen",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "dateien", "accept": ["*/*", "application/pdf", "image/*", "text/*", "message/rfc822", ".eml"] }]
    }
  }
}
